# Local development only. `wrangler dev` reads this file; `wrangler deploy`
# never uploads it — which is exactly why DEV_AUTH lives here and not in
# wrangler.jsonc. /v1/auth/dev mints a session token for any id with no
# credential at all, so it must never be reachable in production.
#
# Do NOT put real secrets in this file (it is committed). Production secrets
# go through `wrangler secret put <NAME>`.
DEV_AUTH=1

# APPLE_JWKS_URL is deliberately NOT set here. It used to point at the test
# double on 127.0.0.1:8788, which meant a plain `wrangler dev` — with no test
# running and nothing listening on that port — turned every /v1/auth/apple
# call into a refused fetch and a 500. The double is only up while the tests
# are, so the tests supply the override themselves (test/dev_server.mjs
# launches wrangler with --var). Unset, the Worker talks to the real
# appleid.apple.com, which is the honest local default.
APPLE_AUDIENCE=com.iprefer.iprefer
