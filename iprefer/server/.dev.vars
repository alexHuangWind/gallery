# Local development only. `wrangler dev` reads this file; `wrangler deploy`
# never uploads it — which is exactly why DEV_AUTH lives here and not in
# wrangler.jsonc. /v1/auth/dev mints a session token for any id with no
# credential at all, so it must never be reachable in production.
#
# Do NOT put real secrets in this file (it is committed). Production secrets
# go through `wrangler secret put <NAME>`.
DEV_AUTH=1

# Apple's key server, replaced locally by the test double that
# test/apple_auth.test.mjs stands up. Real Sign in with Apple can't happen
# against localhost anyway, so pointing this at the fake costs nothing and
# lets the signature checks be tested for real.
APPLE_JWKS_URL=http://127.0.0.1:8788/keys
APPLE_AUDIENCE=com.iprefer.iprefer
